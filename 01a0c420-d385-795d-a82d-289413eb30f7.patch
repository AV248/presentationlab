+  font-style: italic;
+  font-size: 0.78rem;
+}
+.pb-lens-example {
+  display: block;
+  margin-top: 3px;
+  font-style: italic;
+  color: var(--c-ink-muted);
+  font-size: 0.8rem;
+}
+
+.pb-lens-related {
+  margin-top: 9px;
+  font-size: 0.8rem;
+}
+.pb-lens-label {
+  display: inline-block;
+  min-width: 62px;
+  font-size: 0.64rem;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--c-ink-muted);
+  font-weight: 600;
+}
+
+.pb-lens-source {
+  margin-top: 11px;
+  padding-top: 8px;
+  border-top: 1px solid var(--c-line-soft);
+  font-size: 0.72rem;
+  color: var(--c-ink-muted);
+}
+.pb-lens-source a {
+  color: var(--c-accent);
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+}
+
+/* --- the dictionary: word smith (writing) ----------------------------- */
+.pb-smith {
+  display: flex;
+  flex-direction: column;
+  gap: 9px;
+  padding: 14px;
+  border-radius: var(--u-radius-sm);
+  background: var(--c-surface-3);
+  border: 1px solid var(--c-line-soft);
+  font-size: 0.85rem;
+}
+
+.pb-smith-empty {
+  flex-direction: row;
+  align-items: flex-start;
+  gap: 10px;
+  color: var(--c-ink-muted);
+  line-height: 1.6;
+  font-size: 0.8rem;
+}
+.pb-smith-empty > svg {
+  flex: 0 0 auto;
+  color: var(--c-accent);
+  margin-top: 2px;
+}
+
+.pb-smith-head {
+  display: flex;
+  align-items: baseline;
+  gap: 7px;
+  color: var(--c-accent);
+}
+.pb-smith-head > strong {
+  font-family: var(--x-font-display);
+  font-size: 1rem;
+  color: var(--c-ink);
+}
+.pb-smith-phonetic {
+  font-family: var(--x-font-mono);
+  font-size: 0.7rem;
+  color: var(--c-ink-muted);
+}
+
+.pb-smith-sense {
+  font-size: 0.8rem;
+  line-height: 1.6;
+  color: var(--c-ink-soft);
+  padding-bottom: 8px;
+  border-bottom: 1px solid var(--c-line-soft);
+}
+.pb-smith-sense > em {
+  color: var(--c-accent);
+  font-size: 0.74rem;
+}
+
+.pb-smith-label {
+  font-size: 0.64rem;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--c-ink-muted);
+  font-weight: 600;
+}
+
+.pb-smith-list {
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+}
+
+.pb-smith-swap {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  width: 100%;
+  min-height: 38px;
+  padding: 7px 10px;
+  border-radius: var(--u-radius-sm);
+  border: 1px solid transparent;
+  background: var(--c-surface);
+  text-align: left;
+  transition:
+    border-color var(--m-fast) var(--m-ease),
+    background-color var(--m-fast) var(--m-ease);
+}
+.pb-smith-swap:hover,
+.pb-smith-swap:focus-visible {
+  border-color: var(--c-accent-line);
+  background: var(--c-accent-soft);
+}
+.pb-smith-word {
+  font-weight: 600;
+  color: var(--c-ink);
+}
+.pb-smith-syll {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  font-size: 0.68rem;
+  color: var(--c-ink-muted);
+  font-variant-numeric: tabular-nums;
+  flex: 0 0 auto;
+}
+
+.pb-smith-note {
+  font-size: 0.72rem;
+  line-height: 1.55;
+  color: var(--c-ink-muted);
+}
+
+.pb-spin {
+  animation: pb-spin 800ms linear infinite;
+}
+
+/* --- arrivals --------------------------------------------------------- */
+.pb-arrivals-hero {
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+  padding: clamp(18px, 4vw, 30px);
+}
+
+.pb-goal {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  padding: 15px;
+  border-radius: var(--u-radius-sm);
+  background: var(--c-surface-3);
+  border: 1px solid var(--c-line);
+}
+.pb-goal-head {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  font-size: 0.72rem;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--c-ink-muted);
+  font-weight: 600;
+}
+.pb-goal-head > svg {
+  color: var(--c-accent);
+}
+.pb-goal-head > strong {
+  margin-left: auto;
+  font-size: 0.92rem;
+  letter-spacing: 0;
+  color: var(--c-ink);
+}
+.pb-goal-pips {
+  display: flex;
+  gap: 5px;
+}
+.pb-goal-pip {
+  flex: 1;
+  height: 7px;
+  border-radius: 999px;
+  background: var(--c-line);
+  transition: background-color var(--m-base) var(--m-ease);
+}
+.pb-goal-pip[data-filled='true'] {
+  background: var(--c-accent);
+}
+.pb-goal-note {
+  font-size: 0.76rem;
+  line-height: 1.55;
+  color: var(--c-ink-muted);
+  min-height: 2.4em;
+}
+
+.pb-sources {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 10px;
+}
+
+.pb-source-card {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 13px 15px;
+  border-radius: var(--u-radius-sm);
+  background: var(--c-surface);
+  border: 1px solid var(--c-line);
+  transition: border-color var(--m-fast) var(--m-ease);
+}
+.pb-source-card:hover {
+  border-color: var(--c-accent-line);
+}
+.pb-source-card[data-state='unreachable'] {
+  opacity: 0.62;
+}
+.pb-source-head {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  font-size: 0.9rem;
+}
+.pb-source-state {
+  margin-left: auto;
+  font-size: 0.64rem;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--c-ink-muted);
+}
+.pb-source-blurb {
+  font-size: 0.78rem;
+  line-height: 1.55;
+  color: var(--c-ink-soft);
+}
+.pb-source-licence {
+  font-size: 0.68rem;
+  color: var(--c-ink-muted);
+  letter-spacing: 0.02em;
+}
+.pb-source-name {
+  font-size: 0.68rem;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--c-ink-soft);
+}
+
+/* One dot per archive, so you can tell them apart at a glance. */
+.pb-source-dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 999px;
+  flex: 0 0 auto;
+  background: var(--c-accent);
+}
+.pb-source-dot[data-source='wikisource'] {
+  background: var(--c-accent);
+}
+.pb-source-dot[data-source='gutenberg'] {
+  background: var(--c-accent-2);
+}
+.pb-source-dot[data-source='wikiquote'] {
+  background: var(--c-accent-3, var(--c-info));
+}
+
+.pb-arrival {
+  gap: 0.45rem;
+}
+.pb-arrival-source {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  flex-wrap: wrap;
+}
+.pb-arrival-author {
+  font-size: 0.76rem;
+  color: var(--c-ink-muted);
+}
+.pb-arrival-preview {
+  font-size: 0.86rem;
+  line-height: 1.62;
+  color: var(--c-ink-soft);
+  display: -webkit-box;
+  -webkit-line-clamp: 4;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.pb-arrival-actions {
+  display: flex;
+  gap: 6px;
+  flex-wrap: wrap;
+  margin-top: auto;
+  padding-top: 10px;
+  border-top: 1px solid var(--c-line-soft);
+}
+
+.pb-search-block {
+  padding: 18px 20px;
+}
+.pb-search-form {
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+
+/* --- the writing desk ------------------------------------------------- */
+.pb-write-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 14px;
+  align-items: start;
+}
+.pb-write-rail {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  min-width: 0;
+}
+
+/* --- print: the stage and the dictionary are screen-only -------------- */
+@media print {
+  .pb-stage,
+  .pb-lens,
+  .pb-smith,
+  .pb-goal,
+  .pb-sources,
+  .pb-bottomnav,
+  .pb-skip {
+    display: none !important;
+  }
+  .pb-define {
+    border-bottom: 0;
+  }
+}
diff --git a/tsconfig.api.json b/tsconfig.api.json
new file mode 100644
