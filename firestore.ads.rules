rules_version = '2';

// Presentation Buddy — Firestore security rules for the ADS project.
//
// THIS FILE IS FOR THE ADS PROJECT ONLY: `a-a-v-r-i-t`
// The data project (`reflectioncapturedthoughts`) has its own file:
// firestore.rules.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHY THIS PROJECT IS SEPARATE
// ─────────────────────────────────────────────────────────────────────────────
// Ad content lives in its own Firebase project, and this app holds no write
// credential for it whatsoever. That gives three things:
//
//   • A bug or a compromised credential in the main app cannot alter, delete
//     or spam the ads.
//   • An ad operator's mistake cannot reach presentations, profiles or
//     reactions.
//   • Ad traffic gets its own quota, so an impression spike cannot starve
//     the reads that actually matter.
//
// ─────────────────────────────────────────────────────────────────────────────
// THE RULES THEMSELVES
// ─────────────────────────────────────────────────────────────────────────────
// `servingads` is public-read — every visitor, signed in or not, is shown the
// ads. It is web-write-*denied*: no create, update or delete from any client.
// Adverts are edited in this project's Firebase console, or by whatever tool
// the ad operator uses, which holds credentials this site never sees.
//
// Because the collection is world-readable and edited outside this codebase,
// treat every field as untrusted input. The app validates `ImageURL` and
// `RedirectURL` are http(s) before either reaches the DOM — see
// src/services/ads.ts. That check is what stops a document containing
// `RedirectURL: "javascript:..."` from becoming a clickable link.
//
// Deploy with:  firebase deploy --only firestore:rules
// (after `firebase use a-a-v-r-i-t`, or with `--project a-a-v-r-i-t`)

service cloud.firestore {
  match /databases/{database}/documents {

    // The one collection this project serves.
    //
    //   servingads/{id}
    //     Title              string
    //     Content            string
    //     ImageURL           string   (https)
    //     DescriptionPreview string
    //     RedirectURL        string   (https)
    match /servingads/{adId} {
      // Public read. Ads are shown to anonymous visitors by design.
      allow read: if true;

      // No writes from the web. At all. Not even from a signed-in admin of
      // the main app — different project, different rules, no credential.
      allow create, update, delete: if false;
    }

    // Everything else in this project is denied. If a future collection is
    // added it must be named here, which is the behaviour we want: the
    // default is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
