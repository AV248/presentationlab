# Presentation Buddy — environment variables.
# Copy to `.env` for local work. Vercel uses the same nine deployment variable
# names below; keep the real values in the provider dashboard or local .env.
# `npm run audit:secrets` checks that server credentials never enter a VITE_ bundle.

# Public browser values: all five are inlined at build time by next.config.ts.
VITE_SITE_URL=https://presentationbuddy.aavrit.dedyn.io
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: bounded Convex safety snapshots only. No reader/presence role.
VITE_CONVEX_URL=

# Server-only values: never add a VITE_ prefix.
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_AUTHORIZED_PARTIES=https://presentationbuddy.aavrit.dedyn.io
# Turso is authoritative for published presentations and their version history.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Optional, local-only legacy import credentials for `npm run sync:turso`.
# Do not add either of these to Vercel or browser code.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
