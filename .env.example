# Presentation Buddy works fully without any of this.
# Fill these in only if you want to sync a shared `presentations` collection.
# Firebase web config is public by design — access is controlled by Firestore
# security rules, not by these keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
