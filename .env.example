# Presentation Buddy — environment variables.
#
# Copy this file to `.env` for local development, and put the same values into
# Vercel → Project → Settings → Environment Variables for production.
#
#   cp .env.example .env
#
# `.env` is gitignored, so local secrets stay local. This file is committed and
# contains placeholders only. `npm run audit:secrets` fails the build if a
# secret ever appears in a VITE_ variable.
#
# ─────────────────────────────────────────────────────────────────────────────
# THE ONE RULE
# ─────────────────────────────────────────────────────────────────────────────
# Vite inlines EVERY variable beginning with VITE_ into the JavaScript bundle
# that ships to every visitor. So:
#
#   VITE_  → public. Identifiers, project URLs, publishable keys. Vercel type: Plain.
#   no VITE_ → server-only, read by functions in api/. Vercel type: see each one.
#
# There are five in the first group and four in the second. Nothing else is
# needed, and nothing else is read: `src/services/envCheck.ts` is the list, and
# the app's sign-in sheet will name any that are missing.

# =============================================================================
# GROUP 1 — PUBLIC. Bundled into the browser. Vercel type: Plain (all of them).
# =============================================================================

# The canonical origin of the deployed site. Canonical tags, the sitemap, Open
# Graph URLs and structured data all derive from this, so it must match the
# domain actually served — including https://, with no trailing slash. Get it
# wrong and search engines see every page as a duplicate of a domain you do not
# own.
VITE_SITE_URL=https://presentationbuddy.aavrit.dedyn.io

# Clerk publishable key — identifies your Clerk instance in the browser and is
# safe to publish. Clerk Dashboard → API keys → Publishable key.
#
# This is the ONLY identity in the stack: no Firebase Auth, no custom tokens.
# Clerk's session token is presented directly to Postgres (Supabase's
# third-party auth trusts Clerk) and to Convex (the `convex` JWT template).
# Microsoft (Entra ID) sign-in needs nothing here — the client id and secret
# belong in Clerk → SSO connections → Microsoft. Every step, and every failure
# it can produce, is in docs/MICROSOFT.md.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Supabase (Postgres) — the truth. Everything durable lives here: profiles,
# handles, roles, speeches, reactions, shares, ads, posts, feedback, settings.
# Supabase Dashboard → Project Settings → Data API → Project URL.
VITE_SUPABASE_URL=https://your-project.supabase.co

# The public key the browser presents alongside the signed-in session. It is an
# `anon` / publishable key and it is safe to publish: it can only reach what the
# row policies in supabase/schema.sql allow, and those policies ask Postgres who
# is asking. Supabase Dashboard → Project Settings → API keys → anon/public.
#
# A *secret* key here would be a mistake worth noticing: it ignores every
# policy, and the app's environment check will say so in red.
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Convex — the live layer: who is here now, what just happened. Optional in the
# truest sense: leave it empty and everything still works, the site is simply
# quieter, with no presence and no live activity ticker. `npx convex deploy`
# prints this URL.
VITE_CONVEX_URL=

# ── Ads ──────────────────────────────────────────────────────────────────────
# No variables of their own. Sponsored cards are rows in the `ads` table, in the
# same database as everything else, so the two variables above already cover
# them. Everyone may read them; only a role-holder may write. See docs/ADS.md.

# =============================================================================
# GROUP 2 — SERVER ONLY. No VITE_ prefix. Read by the functions in api/.
# =============================================================================

# Clerk secret key. One function reads it: /api/clerk-set-username, which writes
# a claimed username into Clerk. That is what keeps claiming working while
# Clerk's "Restrict changes" toggle is on — the toggle that makes a username
# unchangeable. See docs/USERNAMES.md.
#
# Vercel type: SENSITIVE (masked). This is a real credential; if it is ever
# exposed, rotate it in the Clerk dashboard immediately.
CLERK_SECRET_KEY=sk_test_your_secret_key

# Origins allowed to present a Clerk session token to this API.
# Comma-separated, no trailing slashes, full origin including scheme.
#
# Not optional once your Clerk root domain is aavrit.dedyn.io. Clerk accepts
# cross-origin requests from ANY subdomain of a configured root domain by
# default, so without this a compromised subdomain sharing that root could
# replay a token here. Pin it to the one origin that actually runs the app.
#
# Vercel type: Plain.
CLERK_AUTHORIZED_PARTIES=https://presentationbuddy.aavrit.dedyn.io

# Turso (SQLite) — the reading room. A derived, read-only copy of every
# *published* speech, served from close to the reader, with FTS5 behind the
# search box. It is never the original: Postgres holds that, and
# `npm run sync:turso` / POST /api/sync-library rebuilds this copy from it.
#
# Two functions read these: /api/library (reads the copy) and
# /api/sync-library (rebuilds it). They are read at run time, so a change here
# takes effect on the next request — no redeploy.
#
# Optional. Leave both empty and reading falls back to Postgres: the same rows,
# one hop further away, no full-text index. A complete site, just not the fast
# one.
#
# Create the database at turso.tech, then apply its schema once:  npm run db:turso
TURSO_DATABASE_URL=libsql://your-database.turso.io

# The token for that database.
#
# Vercel type: SENSITIVE (masked). It is a real credential — the functions use
# it to read the reading room, and the sync additionally writes it.
TURSO_AUTH_TOKEN=

# =============================================================================
# LOCAL ONLY — never put these in Vercel. They exist for one script, once.
# =============================================================================
# `npm run migrate:firestore` moves the existing data out of Firestore. It runs
# on your machine, by hand, and the site never reads either of these.
#
#   GOOGLE_APPLICATION_CREDENTIALS   path to the Firebase service account JSON
#   …or FIREBASE_SERVICE_ACCOUNT_JSON  the same JSON inline, on one line
#   SUPABASE_SERVICE_ROLE_KEY        the service key, so the migration may write
#                                    other people's rows (it bypasses the row
#                                    policies on purpose)
#
# Both are real credentials. Keep them in `.env`, and revoke the Firebase
# service account in the Firebase console once the migration has run and the
# site is verified. docs/ARCHITECTURE.md § Moving the data has the order.
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# SUPABASE_SERVICE_ROLE_KEY=
