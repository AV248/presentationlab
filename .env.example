# Presentation Buddy — environment variables.
#
# Copy this file to `.env` for local development, and copy the same values
# into Vercel → Project → Settings → Environment Variables for production.
#
#   cp .env.example .env
#
# `.env` is gitignored. This file is committed and contains placeholders only.
#
# ─────────────────────────────────────────────────────────────────────────────
# THE ONE RULE THAT MATTERS
# ─────────────────────────────────────────────────────────────────────────────
# Vite inlines EVERY variable starting with VITE_ into the JavaScript bundle
# that ships to the browser. Anything secret must therefore live BELOW the
# server-only line, with no VITE_ prefix. Setting VITE_CLERK_SECRET_KEY would
# publish your Clerk secret to every visitor.
#
# Everything in the client-safe block is genuinely public by design and is
# safe to bundle (see the note under each group).

# =============================================================================
# CLIENT-SAFE — bundled into the browser
# =============================================================================

# The canonical origin of the deployed site. Canonical tags, sitemap URLs,
# Open Graph URLs and structured data all derive from this, so it must match
# the domain you actually serve from — including https:// and with no
# trailing slash. Get it wrong and search engines see every page as a
# duplicate of a domain you do not own.
VITE_SITE_URL=https://your-domain.com

# --- Clerk (authentication) ----------------------------------------------
# Clerk replace Firebase Auth entirely: it owns sign-in, sessions, MFA and
# the user profile. The publishable key only identifies your instance in the
# browser and is safe to publish. Clerk Dashboard → API keys.
#
# These are TEST keys (pk_test_). Before going live, add your LIVE keys
# (pk_live_ / sk_live_) and add your production domain under
# Configure → Domains. Test keys are rate-limited and blocked in production
# by Clerk's own safeguards.
# Microsoft (Entra ID) sign-in needs nothing here: the client ID and secret
# belong in the Clerk dashboard → SSO connections → Microsoft. The Entra app
# itself, and every fix it may need, is documented in docs/MICROSOFT.md.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# --- Firebase: the DATA project ------------------------------------------
# Presentations, profiles, reactions, roles, community posts.
#
# Firebase *web* config values are public by design — they identify the
# project in the browser. They are NOT secrets and cannot be used to read
# data on their own. Access to your data is governed entirely by
# firestore.rules, which is the thing actually worth protecting.
#
# In the Firebase console you must also enable:
#   Build → Firestore Database → create database
#   Build → Authentication → Sign-in method → (leave as-is; Clerk handles
#            sign-in. Firebase Auth is only used to exchange Clerk sessions
#            for Firebase tokens via the /api/clerk-firebase-token function.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Ads ----------------------------------------------------------------
# No variables of their own. Ad documents live in `servingads`, inside the
# DATA project above, and are read through the same connection as everything
# else. Create the collection in the Firebase console and add documents to
# it — see docs/ADS.md for the field shape. Reading requires nothing further;
# writing is restricted to role-holders by firestore.rules.

# =============================================================================
# SERVER-ONLY — no VITE_ prefix. Read only by api/clerk-firebase-token.ts.
# =============================================================================

# Clerk secret key. Two serverless endpoints read it:
#   • /api/clerk-firebase-token — mints the Firebase custom token that lets
#     Firestore rules trust a Clerk session.
#   • /api/clerk-set-username — writes a claimed username into Clerk. This is
#     what keeps claiming working while the "Restrict changes" toggle is on
#     (which is what makes a username unchangeable). See docs/USERNAMES.md.
# THIS IS A REAL CREDENTIAL. If it is ever exposed, rotate it immediately in
# the Clerk dashboard.
CLERK_SECRET_KEY=sk_test_your_secret_key

# Origins allowed to present a Clerk session token to this API.
# Comma-separated, no trailing slashes, full origin including scheme.
#
# This is NOT optional once your Clerk root domain is aavrit.dedyn.io. Clerk
# accepts cross-origin requests from ANY subdomain of a configured root domain
# by default, so without this a compromised subdomain sharing that root could
# replay a token here. Pin it to the one origin that actually runs the app.
CLERK_AUTHORIZED_PARTIES=https://presentationbuddy.aavrit.dedyn.io

# Firebase Admin service account for the DATA project, used only to mint
# custom tokens. Firebase console → Project settings → Service accounts →
# Generate new private key.
#
# Paste the entire JSON on a SINGLE line. If your tooling mangles the
# newlines, base64-encode the file instead:
#   base64 -w0 serviceAccount.json
# and prefix the value with "base64:".
FIREBASE_SERVICE_ACCOUNT_JSON=
