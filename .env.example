# Presentation Buddy works completely without these.
# Fill them in only to switch on the shared library, sign-in and community.
#
# Firebase *web* config values are public by design: they identify the project
# in the browser. Access to data is governed entirely by your Firestore
# security rules (see firestore.rules), never by these keys.
#
# In the Firebase console you also need to enable:
#   Authentication → Sign-in method → Google
#   Authentication → Sign-in method → Microsoft
#   Firestore Database → create database → deploy firestore.rules

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
