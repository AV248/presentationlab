rules_version = '2';

// Presentation Buddy — Firestore security rules.
//
// THIS FILE IS FOR THE DATA PROJECT: `reflectioncapturedthoughts`
// The ads project (`a-a-v-r-i-t`) has its own, much smaller file:
// firestore.ads.rules.
//
// ─────────────────────────────────────────────────────────────────────────────
// HOW SIGN-IN REACHES THESE RULES
// ─────────────────────────────────────────────────────────────────────────────
// Clerk owns sign-in. Firestore cannot validate a Clerk JWT on its own, so
// api/clerk-firebase-token.ts verifies the Clerk session server-side and mints
// a Firebase custom token carrying the Clerk user id. By the time a write
// reaches this file, `request.auth.uid` is that Clerk user id — stable across
// sessions and devices.
//
// isSignedIn() therefore requires either that minted token or one of the
// legacy Firebase providers. Enabling anonymous or email/password auth in the
// Firebase console does NOT open a door here: those providers are named and
// everything else is refused.
//
// ─────────────────────────────────────────────────────────────────────────────
// THE SHAPE OF THE POLICY
// ─────────────────────────────────────────────────────────────────────────────
// Reading the library is open to everyone. Writing anything — a speech, a
// like, a share, a note — requires a signed-in account. People may only delete
// their own work, and only an owner or admin may touch anyone else's.
//
// The one deliberate exception is *counters*. A like on someone else's speech
// has to move a number on a document you do not own, so a signed-in person may
// change `views`, `likes`, `dislikes` and `shares` — and nothing else.
// `diff().affectedKeys()` is what makes that safe: the moment a write touches
// the title, the body or the author it stops being a counter update and the
// owner check applies instead.
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Identity
    // ------------------------------------------------------------------

    // True only for the two sign-in paths this app actually uses.
    //
    // Being explicit here is the point: if someone later flips on anonymous
    // or email/password auth in the Firebase console — for testing, or by
    // accident — it grants nothing. Anonymous sign-in in particular is a
    // common way to accidentally give the whole internet write access.
    function isSignedIn() {
      return request.auth != null
        && (
          // Minted by api/clerk-firebase-token.ts from a verified Clerk session.
          request.auth.token.get('provider', '') == 'clerk'
          // Legacy Firebase providers, kept for installs without Clerk.
          || request.auth.token.firebase.sign_in_provider == 'google.com'
          || request.auth.token.firebase.sign_in_provider == 'microsoft.com'
        );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function hasAdminDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return hasAdminDoc() && adminDoc().role in ['admin', 'owner'];
    }

    function isSiteOwner() {
      return hasAdminDoc() && adminDoc().role == 'owner';
    }

    // ------------------------------------------------------------------
    // Counter guards
    // ------------------------------------------------------------------

    // The set of keys a write actually changed.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // True when a write only moves the four public counters.
    function onlyCounters() {
      return changed().hasOnly(['views', 'likes', 'dislikes', 'shares']);
    }

    // A counter may only ever move up by `max` per write, and never below
    // zero. Without this a hostile client could write likes = 10000000 in
    // one shot, which is exactly what a leaderboard invites.
    function bumpedBy(field, max) {
      return !(field in changed())
        || (request.resource.data[field] is int
            && request.resource.data[field] >= 0
            && request.resource.data[field] <= resource.data.get(field, 0) + max);
    }

    function saneCounters() {
      return bumpedBy('views', 1)
        && bumpedBy('likes', 1)
        && bumpedBy('dislikes', 1)
        && bumpedBy('shares', 1);
    }

    // ------------------------------------------------------------------
    // Speeches
    //
    // Anyone may read; signed-in people may publish and may only change or
    // remove their own — except for the public counters, which any
    // signed-in person may nudge by one.
    // ------------------------------------------------------------------
    match /presentations/{speechId} {
      allow read: if true;

      // Note the capitalised field names: they are the original schema from
      // the first version of this site and the client still writes them, so
      // the rules have to validate the same keys the code sends.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.Title is string
        && request.resource.data.Title.size() > 0
        && request.resource.data.Title.size() <= 200
        && request.resource.data.Content is string
        && request.resource.data.Content.size() <= 200000;

      allow update: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid)
        || (isSignedIn() && onlyCounters() && saneCounters());

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);

      // The public view counter: one increment per read, no personal data.
      match /views/{viewId} {
        allow read: if true;
        allow create: if isSignedIn();
      }
    }

    // ------------------------------------------------------------------
    // Reactions. One document per (person, speech).
    //
    // The id must be your own uid joined to the speech id, so a person can
    // never hold two reactions on one speech — and, more importantly, so
    // they cannot write a reaction under somebody else's id.
    // ------------------------------------------------------------------
    match /reactions/{reactionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && reactionId == request.auth.uid + '_' + request.resource.data.speechId
        && request.resource.data.kind in ['like', 'dislike'];
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // Shares. Same shape as reactions.
    // ------------------------------------------------------------------
    match /shares/{shareId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // Open mic notes (the old "bloggerblogs" collection).
    // ------------------------------------------------------------------
    match /bloggerblogs/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('Content', '').size() <= 20000;
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ------------------------------------------------------------------
    // Contributor profiles and reaction tallies (the old "bloggers").
    //
    // You maintain your own profile. Everyone else may only move the
    // received-reaction tallies, because a like on your speech has to be
    // recorded by the person giving it, not by you. Those three fields are
    // capped so the leaderboard cannot be written directly.
    // ------------------------------------------------------------------
    match /bloggers/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) || isAdmin();

      allow update: if isOwner(uid)
        || isAdmin()
        || (isSignedIn()
            && changed().hasOnly(['likesReceived', 'dislikesReceived', 'points', 'updatedAt'])
            && bumpedBy('likesReceived', 1)
            && bumpedBy('dislikesReceived', 1)
            // Points can move by more than one when several reactions are
            // reconciled at once, but never by an unbounded amount.
            && bumpedBy('points', 100));

      allow delete: if isSiteOwner();
    }

    // ------------------------------------------------------------------
    // Profile mirror for every signed-in person.
    //
    // The key list is closed: without hasOnly() an account could use its
    // own profile document as a scratch pad of arbitrary size.
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'uid', 'email', 'displayName', 'photoURL', 'providerId',
             'lastSeen', 'createdAt'
           ]);
      allow delete: if isSiteOwner();
    }

    // ------------------------------------------------------------------
    // Roles. Readable by their holder; writable only by the site owner.
    // Nobody can grant themselves a role from the client — this is the
    // collection that, if writable, would hand over the whole workspace.
    // ------------------------------------------------------------------
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSiteOwner();
    }

    // ------------------------------------------------------------------
    // Sponsor slots shown alongside speeches. Public to read (the site
    // renders them for signed-out visitors), admin-only to change.
    // ------------------------------------------------------------------
    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Legacy local ad collection — NO LONGER USED.
    //
    // Ads moved to the `servingads` collection in the separate ads project
    // (see firestore.ads.rules). Nothing in the app reads or writes this
    // one any more, so it is closed: allowing writes to a collection no
    // code uses is pure attack surface.
    // ------------------------------------------------------------------
    match /ads/{adId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Legacy collection from the first version of this site.
    // Kept readable so an existing e-mail allow-list still grants admin
    // access. It is never written to, and it contains no passwords.
    // ------------------------------------------------------------------
    match /admin/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Anything not named above is denied outright. This catch-all is what
    // makes a typo in a collection name fail closed rather than open.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
