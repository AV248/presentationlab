{
  "name": "presentation-buddy",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "description": "Presentation Buddy 2.3 — premium themes, real ads, shareable links, faster. A fully themeable workspace to write, coach, rehearse and deliver talks.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke/run.mjs",
    "verify": "npm run typecheck && npm run smoke",
    "cards": "node scripts/cards/run.mjs",
    "prerender": "node scripts/prerender/run.mjs",
    "sitemap": "node scripts/sitemap/run.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
