{
  "name": "presentation-buddy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Presentation Buddy — write, rehearse and deliver presentations with confidence.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
