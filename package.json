{
  "name": "presentation-buddy",
  "private": true,
  "version": "2.6.2",
  "type": "module",
  "description": "Presentation Buddy 2.6.2 \u2014 pure-sky falling-leaves entry, owner-only festival layer over 13.7M user themes, /username handles, and pb.devs.surf-only shared links.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json",
    "smoke": "node scripts/smoke/run.mjs",
    "verify": "npm run typecheck && npm run audit:secrets && npm run smoke",
    "cards": "node scripts/cards/run.mjs",
    "prerender": "node scripts/prerender/run.mjs",
    "sitemap": "node scripts/sitemap/run.mjs",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "audit:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@clerk/clerk-react": "^5.61.10",
    "@clerk/themes": "^2.4.57",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": "22.x"
  }
}
