{
  "name": "presentation-buddy",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "description": "Presentation Buddy 3.1 \u2014 Next.js App Router in front of one identity and three databases: Supabase/Postgres for every durable record, Turso for the reading room, Convex for presence and live activity. The Vercel environment variable names are unchanged from 2.x.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/cards/run.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run typecheck && npm run audit:secrets && npm run check:schema && npm run check:pg && npm run check:reading && npm run check:library",
    "verify:all": "PB_REQUIRE_PG=1 npm run verify && npm run build && npm run check:routes",
    "cards": "node scripts/cards/run.mjs",
    "audit:secrets": "node scripts/check-secrets.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "db:turso": "node scripts/turso/apply.mjs",
    "migrate:firestore": "node scripts/migrate/from-firestore.mjs",
    "sync:turso": "node scripts/turso/sync.mjs",
    "check:library": "node scripts/turso/selftest.mjs",
    "check:reading": "node scripts/check-reading.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:pg": "node scripts/check-pg.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@clerk/clerk-react": "^5.61.10",
    "@clerk/themes": "^2.4.57",
    "@libsql/client": "^0.15.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "convex": "^1.29.0",
    "lucide-react": "^1.47.0",
    "next": "^16.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "firebase-admin": "^14.5.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  }
}
