{
  "name": "Presentation Buddy",
  "short_name": "Pres. Buddy",
  "description": "Write, coach, rehearse and deliver presentations — beautifully themeable, local-first and offline ready.",
  "id": "/presentation-buddy",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070b18",
  "theme_color": "#070b18",
  "categories": ["productivity", "education", "utilities"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Write a speech",
      "short_name": "Studio",
      "url": "./index.html#/studio",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Rehearse",
      "short_name": "Practice",
      "url": "./index.html#/practice",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Theme studio",
      "short_name": "Themes",
      "url": "./index.html#/themes",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
